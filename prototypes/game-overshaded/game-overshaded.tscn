[sub_resource type="GDScript" id="GDScript_4xjbh"]
script/source = "@tool
extends U
@warning_ignore(\"unused_parameter\")
func run(other, direction, from, to):
	var other_name = other.name
	
	print(\"replacing child -> \" + other_name)
	
	if to.get_child_count() == 0 and other_name != \"Normal\":
		# don't allow starting with applied effect
		return
	
	if to.get_child_count() > 0:
		if other_name != \"Normal\" and to.get_child(0).name != \"Normal\":
			# don't allow reprossessing the images
			return
	
	if to.get_child_count() > 0:
		for child in to.get_children():
			child.queue_free()	
	
	var image = to.get_node(\"%\" + other_name).duplicate()
	image.visible = true
	to.add_child(image)
"

